{
    "$schema": "http://json.schemastore.org/tsconfig",
    "extends": "../tsconfigbase",
    "compilerOptions": {
      "jsx": "react-jsx",
      "outDir": "ts-build/",
      "rootDir": "src",
      "sourceMap": true,
      "esModuleInterop": true,
      "types": ["node"]
    },
    "include": ["src/**/*"],
    // See https://github.com/webpack/webpack-cli/issues/2458#issuecomment-846635277
    "ts-node": {
      "compilerOptions": { "module": "commonjs", "rootDir": "." }
    }
  }
